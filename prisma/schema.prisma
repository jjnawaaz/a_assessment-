generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Paste {
  id      String @id @default(cuid())
  content String @db.Text

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  maxViews  Int?
  viewCount Int  @default(0)

  @@index([expiresAt])
}
